# viiwork on Strata, CUDA.
#
# Upstream publishes no image, only a Dockerfile, so this is two builds: the
# upstream image from the pinned tag, then viiwork dropped into it — the same
# shape as Dockerfile.vllm. `make docker-strata-cuda` runs both:
#
#   docker build -t strata-cuda:<STRATA_VERSION> https://github.com/Niko1221/Strata.git#<STRATA_COMMIT>
#   docker build -f docker/Dockerfile.strata-cuda -t viiwork-strata-cuda .
#
# The checkout is /opt/strata and its Python packages are in a venv, so the
# model's block is
#   strata: {dir: /opt/strata, python: /opt/strata/.venv/bin/python}
# and the engine the JSON's "exe" names is /opt/strata/engine/strata.
#
# Served under viiwork on three RTX A4000 at 262,144 context: v0.1.39 on
# 2026-10-04 (built with CUDA_ARCHITECTURES=86 and BUILD_VISION=0), and
# v0.1.40.1 on 2026-10-07 (a 200,244-token prompt read at 2,527 tok/s). v0.1.41
# served on two RTX 4090 on 2026-10-09, and v0.1.42 on an RTX 5090 and on two
# RTX 4090 on 2026-10-10, one to six slots; build upstream's image with
# BuildKit (BUILDS.md).
# nvidia-smi is injected by the container runtime, as in Dockerfile.vllm.

ARG STRATA_VERSION=v0.1.42

FROM golang:1.27.1 AS go-build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
ARG VERSION=dev
RUN CGO_ENABLED=0 go build -ldflags "-X main.version=${VERSION}" -o /viiwork ./cmd/viiwork

FROM strata-cuda:${STRATA_VERSION}

# Upstream's entrypoint runs setup.py, which downloads a model and starts one
# server. viiwork is the process here and starts the servers itself.
ENTRYPOINT []
# Upstream's healthcheck probes port 8080, which nothing listens on here.
HEALTHCHECK NONE

RUN apt-get update \
    && apt-get install -y --no-install-recommends ipmitool \
    && rm -rf /var/lib/apt/lists/*

COPY --from=go-build /viiwork /usr/local/bin/

WORKDIR /
EXPOSE 8086/tcp 7946/tcp 7946/udp
CMD ["viiwork", "--config", "/etc/viiwork/viiwork.yaml"]
