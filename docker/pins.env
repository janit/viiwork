# The engine pins, in one place. Sourced by scripts/gobuild.sh (the llama.cpp
# pin is stamped into every binary) and scripts/release-images.sh, and checked
# against the Dockerfiles' ARG defaults by scripts/pins_test.sh.

# The llama.cpp release the fleet builds (docker/Dockerfile.rocm) and a Mac
# downloads (scripts/macos/fetch-llama.sh, the setup wizard).
LLAMA_CPP_VERSION=b12359

# The sha256 of llama-<LLAMA_CPP_VERSION>-bin-macos-arm64.tar.gz, stamped into
# every binary beside the pin: a Mac fetches its llama.cpp by this digest from
# the asset's fixed URL, so the release signature covers the engine too.
# Change it with LLAMA_CPP_VERSION, from the release's asset list.
LLAMA_CPP_MACOS_SHA256=82b00abc740160e1b9980e6cc79c117345fa34af058c80e6c0a69aa8ddccde75

# The nearest llama.cpp build at or after LLAMA_CPP_VERSION for which upstream
# publishes server-cuda and server-vulkan images (not every build has them;
# b12359, llama.cpp v1.0.0, has none, and b12375 is the first build after it
# that does, as of 2026-11-15). The published viiwork-llamacpp-* images sit on it.
LLAMA_CPP_IMAGE_BUILD=b12375

# The vLLM image viiwork-vllm sits on (docker/Dockerfile.vllm).
VLLM_VERSION=v0.32.0

# The Strata release the viiwork-strata images carry. docker/Dockerfile.strata
# builds it from source for gfx906; docker/Dockerfile.strata-cuda sits on a
# CUDA image built from the same release (STRATA_CUDA_IMAGE, made by
# scripts/build-strata-cuda-base.sh). The gfx906 patch in docker/strata/,
# when there is one, is named for this version and must be re-cut when it
# changes.
STRATA_VERSION=v0.2.15
# The commit that tag names. A tag can be moved; both images check out the tag
# and then refuse anything but this commit. Upstream rewrote its history on
# 2026-10-06, which moved every tag: the v0.1.39 pin of v2.8.0 to v2.8.2
# (6f32ec07) no longer builds.
STRATA_COMMIT=c77572806996349b49995e4f98d41b5294d36a21

# The CUDA 13 image of STRATA_VERSION, a local tag: upstream publishes its
# ready-made images (ghcr.io/niko1221/strata:<version>-cuda13) some time after
# a release, and 0.2.14 and 0.2.15 had none, so scripts/build-strata-cuda-base.sh builds
# it from upstream's own docker/build.sh and the engine package of the signed
# update feed. Its /opt/strata/terminal/COMMIT is STRATA_COMMIT.
STRATA_CUDA_IMAGE=strata-cuda-base:0.2.15
# The sha256 of that engine package's archive
# (strata-engine-0.1.60-linux-x86_64-cuda-cuda13.tar.gz), as the signed feed
# lists it; the build script refuses any other.
STRATA_CUDA_ENGINE_SHA256=a72c194c8f6de96629ed53079b5e344ab81223d45667a53f6a6d79398895aa50

# The ROCm base viiwork-strata builds on. AMD's own ROCm no longer ships gfx906
# libraries; this is the community image Strata's docs name, held by digest
# because its tag can move.
STRATA_ROCM_BASE=mixa3607/rocm-gfx906:7.14-complete@sha256:622c025824d465faa0f5e59eea4f723845032011df273c3b11e25031965fc428
