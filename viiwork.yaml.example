# viiwork 2 node config: one file per machine. Every model on the machine is an
# entry under models:, the API is on 8086 and gossip on 7946 everywhere.
# Converting from v1: docs/migrating-to-v2.md.
#
# The mesh secret comes from the environment, never from this file:
#   VIIWORK_MESH_SECRET=$(openssl rand -base64 32)
# To run a mesh without a secret, leave it unset and set mesh.open: true.

node:
  name: ""                   # empty = hostname; must be unique in the mesh
  state_dir: /var/lib/viiwork # durable state (alias table); a real volume in docker

api:
  host: 0.0.0.0
  port: 8086

mesh:
  network: tailnet           # tailnet | lan
  open: false
  seeds: []                  # optional "ip:7946" of any member, e.g. a gateway host

# Every key above `models:` is the node's. Inside a model, `engine:` names the
# engine AND the optional block below it that belongs to that engine: write
# `llamacpp:` under `engine: llamacpp` and nothing else — a block for another
# engine, or a misspelled one, is rejected by name at startup.
#
# Keep an engine block small. Its long tail of tuning flags belongs in `args:`,
# which is appended last so an operator's flag always wins; a block key exists
# only where the NODE decides the value or publishes it to the mesh.
#
# v2.2.0 ships `llamacpp`, `vllm` and `freetoken`. Adding another is one package
# and one blank import: see docs/adding-an-engine.md. An engine is named for the
# engine, never for a GPU vendor — vLLM already has a ROCm build and FreeToken
# may grow one.
models:
  - name: Qwen3.8-27B        # the served model id
    engine: llamacpp         # names the engine and the llamacpp: block below
    path: /models/Qwen3.8-27B-UD-Q4_K_XL.gguf
    gpus: [0, 1]
    gpus_per_backend: 2      # one backend split across both cards
    context: 49152           # tokens PER SLOT
    parallel: 2
    startup_timeout: 45m     # split models load slowly; the default is 10m
    args: ["--spec-type", "draft-mtp", "--spec-draft-n-max", "1",
           "--chat-template-kwargs", '{"enable_thinking": false}']
    llamacpp:                # optional; these are the defaults
      binary: llama-server
      split_mode: layer      # layer | row
  - name: granite-4.2-8b
    engine: llamacpp
    path: /models/granite-4.2-8b-Q8_0.gguf
    gpus: [2]
    context: 16384
    parallel: 2

  # The two models below are alternatives to the llamacpp ones above, not
  # additions: they claim the same cards, and a GPU may belong to one model
  # only. Uncommenting one as it stands is refused at startup with
  # "GPU 0 is already used by models[0]" — give it free cards, or remove the
  # model holding them.

  # vLLM. Needs GPUs — it does not run on CPU, and a config without `gpus:` is
  # refused at startup rather than started as a backend that would never load.
  # One backend is split across its cards: --tensor-parallel-size is simply how
  # many it was given, so `gpus_per_backend` is the split.
  #
  # `context` and `parallel` become --max-model-len and --max-num-seqs, always,
  # from the node's own numbers. v1 let a zero mean "take the checkpoint's
  # limit"; a backend serving more than the node advertises makes ctx a lie on
  # every dashboard.
  # - name: Qwen3.8-27B-fp8
  #   engine: vllm
  #   path: /models/Qwen3.8-27B-FP8
  #   gpus: [0, 1]
  #   gpus_per_backend: 2      # one backend, tensor-parallel across both
  #   context: 16384           # -> --max-model-len
  #   parallel: 8              # -> --max-num-seqs
  #   startup_timeout: 45m     # profiling, KV allocation and CUDA graph capture
  #                            # happen before it answers anything; the engine
  #                            # default is 20m, which is the single-card figure
  #   args: ["--enable-prefix-caching", "--kv-cache-dtype", "fp8"]
  #   vllm:                    # optional; these are the defaults
  #     binary: vllm
  #     gpu_memory_utilization: 0.90

  # FreeToken. One card per process — the engine rejects more than one, so
  # `gpus_per_backend` must be 1 and three cards means three backends.
  # - name: DSV4-Flash
  #   engine: freetoken
  #   path: /models/DSV4-Flash-NVFP4
  #   gpus: [0, 1, 2]
  #   gpus_per_backend: 1      # three single-card backends
  #   context: 32768           # -> --max-seq-len-override
  #   parallel: 4              # -> --max-running-requests
  #   startup_timeout: 45m
  #   args: ["--attention-backend", "flashinfer"]
  #   freetoken:               # optional; these are the defaults
  #     binary: ft
  #     memory_ratio: 0.90
  #     moe_backend: auto      # auto | fused | offload | cpu | hybrid
  #     # KV-cache token floor, reserved before --moe-cache-auto fills MoE
  #     # experts. It does NOTHING on its own: viiwork never generates
  #     # --moe-cache-auto, so this only bites if you add that flag to `args:`.
  #     #
  #     # If you do, set this to at least context x parallel. That expert cache
  #     # is MoE-priority and will take VRAM the KV cache needs; below that
  #     # floor the backend serves less context than the node publishes to the
  #     # mesh, which is the one number a dashboard must not be wrong about.
  #     kv_reserve_tokens: 0

power:
  source: none               # auto | dcmi | sdr | sensor:<NAME> | none
